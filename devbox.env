# Read by scripts/devbox-build.sh on the devbox worker. All settings are optional.

# The app logs a line matching this when its on-device tests finish. The build
# waits up to DEVBOX_WAIT_SECONDS for it and fails if it never appears.
DEVBOX_WAIT_FOR='\[native-crypto\] DONE'

# A line matching this means a test failed. The build then exits non-zero.
DEVBOX_FAIL_ON='\[native-crypto\] FAIL'

# DEVBOX_WAIT_SECONDS=60
# DEVBOX_SCHEME=MyApp   # when the scheme is not named after the .xcworkspace
